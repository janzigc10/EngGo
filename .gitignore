# dependencies
/node_modules
/.pnpm-store/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
playwright-report
test-results
.pytest_cache/

# next.js
/.next/
/out/

# production
/build

